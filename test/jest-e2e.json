{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup-e2e.ts"],
  "moduleNameMapper": {
    "^expo-server-sdk$": "<rootDir>/mocks/expo-server-sdk.mock.ts"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 20000
}
