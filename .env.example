# Conexión a MySQL (TypeORM, no Prisma: variables discretas, no DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change_this_password
DB_DATABASE=bd_backend_v3
DB_CHARSET=utf8mb4
# Certificado CA (PEM) para MySQL con SSL obligatorio, p.ej. el ca.pem de Aiven.
# Acepta saltos de línea reales o escapados como \n. Sin definir: sin SSL (MySQL local).
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# JWT — access token de vida corta + refresh token de vida larga
JWT_SECRET=change_this_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

PORT=3000

# Seguridad transversal (Paso 11)
# Whitelist de CORS separada por comas. Sin definir, aplica el default de
# desarrollo (Expo/web local) en src/main.ts.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3010
# Rate limiting global (ThrottlerModule): ventana en ms y máximo de requests por IP en esa ventana.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
# Tamaño máximo (en MB) de un adjunto subido como archivo real (POST /reportes/:id/adjuntos/upload).
UPLOAD_MAX_FILE_SIZE_MB=5

# Solo al desplegar detrás de un proxy inverso (por ejemplo en un VPS).
# Cantidad de reverse proxies delante de Node (1 con Caddy) — sin esto el rate
# limiting ve a todos los usuarios como la misma IP. Dejar sin definir en local.
# TRUST_PROXY=1
# Escuchar solo en loopback para que Node no quede expuesto sin HTTPS.
# HOST=127.0.0.1

# Correo (recuperación de contraseña, CU59). SMTP; con Gmail hace falta una
# "contraseña de aplicación" (Cuenta de Google > Seguridad > Verificación en dos
# pasos > Contraseñas de aplicaciones). Sin MAIL_USER y MAIL_PASS el código no se envía.
# Ojo: Render gratuito bloquea los puertos SMTP 25, 465 y 587; ahí no funciona.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
# Opcionales: nombre que ve quien recibe el correo y dirección de remitente (por defecto MAIL_USER)
# MAIL_FROM_NAME=PCD App
# MAIL_FROM=
# Pedidos por minuto y por IP a /auth/forgot-password, /auth/verify-otp y /auth/reset-password (por defecto 5)
# PASSWORD_RESET_THROTTLE_LIMIT=5

# Días que se guardan las ubicaciones de los PCD (por defecto 30)
UBICACIONES_RETENCION_DIAS=30
