# Entorno para test:e2e — misma instancia MySQL local, base de datos separada
# (bd_app_test) para no tocar los datos de bd_app. No versionar credenciales
# reales acá; en CI este archivo se reemplaza por variables del workflow.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=bd_app_test
DB_CHARSET=utf8mb4

JWT_SECRET=test-secret-solo-para-e2e-no-usar-en-otro-lado
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

PORT=3001

CORS_ORIGINS=http://localhost:8081
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000
UPLOAD_MAX_FILE_SIZE_MB=5

DB_SSL_CA=

# Recuperación de contraseña: sin el límite estricto de producción, los e2e hacen muchos pedidos seguidos
PASSWORD_RESET_THROTTLE_LIMIT=1000
